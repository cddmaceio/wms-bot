{
  "name": "WMS Bot - Com tratamento de falhas",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 0 6 * * 1-6"
            }
          ]
        }
      },
      "id": "64d1bd41-eaf9-4e40-b48a-67bf2ab2e0ef",
      "name": "Agendamento diário às 6h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaa01",
              "name": "BOT_URL",
              "value": "https://wmsbot.cddmaceio.site",
              "type": "string"
            },
            {
              "id": "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaa02",
              "name": "EVOLUTION_BASE_URL",
              "value": "https://evogoapi.cddmaceio.site",
              "type": "string"
            },
            {
              "id": "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaa03",
              "name": "EVOLUTION_APIKEY",
              "value": "SEU-APIKEY",
              "type": "string"
            },
            {
              "id": "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaa04",
              "name": "EVOLUTION_NUMBER",
              "value": "5511999999999",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "b744e1dd-007a-437f-b0f0-b87a565a726b",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        0,
        144
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').item.json.BOT_URL }}/run",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{ \"dateMode\": \"today\" }",
        "options": {
          "timeout": 600000
        }
      },
      "id": "e404925a-c84e-47bf-8fa5-cdf098a10d76",
      "name": "Executar Bot (baixar e enviar CSV)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        0,
        288
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.success === true }}",
              "rightValue": "true",
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "226f1edf-47c4-4640-a0f0-2944ee8964d2",
      "name": "Executou com sucesso?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        0,
        432
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.upload?.ok === true }}",
              "rightValue": "true",
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "82068c00-ea35-44d6-b641-da4bda835676",
      "name": "Upload OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        240,
        560
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.upload == null }}",
              "rightValue": "true",
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "51288d5c-1945-495c-a4cc-7166b721223b",
      "name": "API não configurada?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        240,
        704
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').item.json.EVOLUTION_BASE_URL.replace(/[/]+$/, '') + '/send/text' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $('Config').item.json.EVOLUTION_APIKEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { number: $('Config').item.json.EVOLUTION_NUMBER, text: 'WMS: importacao concluida. Data: ' + $json.dateUsed + ' | Mapas: ' + ($json.upload.maps_upserted ?? '?') + ' | Registros: ' + ($json.upload.processed ?? '?') } }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "cc2f41b3-13fa-408d-aba7-d71d72c1a7c7",
      "name": "Notificar Sucesso",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        992
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').item.json.EVOLUTION_BASE_URL.replace(/[/]+$/, '') + '/send/text' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $('Config').item.json.EVOLUTION_APIKEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { number: $('Config').item.json.EVOLUTION_NUMBER, text: 'WMS: falha no upload. ' + ($json.upload?.error || $json.upload?.message || ('HTTP ' + ($json.upload?.status ?? '?'))) } }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "e728eb67-5f27-476f-9e2e-5d9a6f1fe816",
      "name": "Notificar Erro Upload",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        640,
        848
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').item.json.EVOLUTION_BASE_URL.replace(/[/]+$/, '') + '/send/text' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $('Config').item.json.EVOLUTION_APIKEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { number: $('Config').item.json.EVOLUTION_NUMBER, text: 'WMS: API nao configurada. Arquivo: ' + $json.file } }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "afa8a13d-5a2f-467e-bc87-dd96a5f483ed",
      "name": "Notificar Sem API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        624,
        672
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').item.json.EVOLUTION_BASE_URL.replace(/[/]+$/, '') + '/send/text' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $('Config').item.json.EVOLUTION_APIKEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { number: $('Config').item.json.EVOLUTION_NUMBER, text: 'WMS: falha na execucao. ' + (typeof $json.error === 'string' ? $json.error : JSON.stringify($json.error ?? $json)) } }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "4c2bd7d2-dfb4-47e5-a543-573587c3f131",
      "name": "Notificar Erro Execução",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -384,
        704
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "onError": "continueErrorOutput"
    },
    {
      "id": "001efb17-2276-4685-ab8f-2272600e1b46",
      "name": "Registrar falha da importacao",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        900,
        700
      ],
      "parameters": {
        "errorType": "errorMessage",
        "errorMessage": "={{ 'Falha na importacao: ' + JSON.stringify($json) + ' | Resposta do bot: ' + JSON.stringify($('Executar Bot (baixar e enviar CSV)').first().json) }}"
      }
    },
    {
      "id": "a54d3192-7bb5-4483-910e-9a61093de415",
      "name": "Registrar falha do WhatsApp",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        900,
        1000
      ],
      "parameters": {
        "errorType": "errorMessage",
        "errorMessage": "={{ 'Falha no WhatsApp; confira o resultado da importacao: ' + JSON.stringify($json) + ' | Resposta do bot: ' + JSON.stringify($('Executar Bot (baixar e enviar CSV)').first().json) }}"
      }
    }
  ],
