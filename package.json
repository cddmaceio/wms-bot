{
  "name": "wms-bot",
  "version": "2.0.0",
  "private": true,
  "description": "WMS autônomo com agenda, SQLite e WhatsApp",
  "engines": {
    "node": ">=24 <25"
  },
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "dev": "npm run build && npm start",
    "test": "npm run build && node --test download.test.js login.test.js tests/*.test.cjs",
    "test:ui": "npm run build && node tests/ui-smoke.cjs",
    "backup": "node --env-file-if-exists=.env dist/backup.js"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "csv-parse": "7.0.3",
    "express": "5.3.0",
    "playwright": "1.64.1",
    "proper-lockfile": "4.1.2",
    "qrcode": "1.5.4",
    "whatsapp-web.js": "1.34.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "typescript": "~5.9.3"
  }
}
